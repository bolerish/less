{
  "name": "less",
  "version": "1.2.0",
  "private": true,
  "description": "Hide what you don’t need.",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "lint": "oxlint --deny correctness --deny perf",
    "lint:fix": "oxlint --fix",
    "lint:types": "wxt prepare && tsc -b",
    "fmt": "oxfmt --write",
    "fmt:check": "oxfmt --check",
    "compile": "tsc --noEmit",
    "postinstall": "wxt prepare",
    "verify:panel": "node scripts/verify-sidepanel.ts",
    "verify:dev": "node scripts/verify-dev.ts",
    "verify:failure": "node scripts/verify-failure-popup.ts"
  },
  "dependencies": {
    "@bolerish/tokens": "0.18.1",
    "@bolerish/ui": "0.18.1",
    "@phosphor-icons/react": "^2.1.10",
    "@stylexjs/stylex": "0.19.0",
    "dexie": "^4.4.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@rolldown/plugin-babel": "^0.2.3",
    "@stylexjs/babel-plugin": "0.19.0",
    "@types/babel__core": "^7.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.0.2",
    "@wxt-dev/auto-icons": "^1.1.1",
    "@wxt-dev/module-react": "^1.2.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "oxfmt": "^0.55.0",
    "oxlint": "^1.70.0",
    "playwright-core": "1.62.1",
    "postcss": "^8.5.32",
    "typescript": "^5.9.3",
    "vite": "8.0.16",
    "web-ext": "^10.8.0",
    "wxt": "^0.21.5"
  }
}
